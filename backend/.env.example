# Bu dosya örnektir — kopyalayıp `.env` olarak kaydedin ve değerleri düzenleyin.
# Değerleri tırnak içinde yazın.

# MongoDB Atlas bağlantı string'i (bulut veritabanı)
# Örnek: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL="mongodb+srv://KULLANICI:SIFRE@CLUSTER.mongodb.net/?retryWrites=true&w=majority"

# Veritabanı adı (otomatik oluşturulur)
DB_NAME="lexkasa_db"

# Frontend adres(ler)iniz — virgülle ayırın
CORS_ORIGINS="https://sizin-domain.com,http://localhost:3000"

# JWT için güvenlik anahtarı — python3 -c "import secrets; print(secrets.token_hex(32))" ile üretin
JWT_SECRET="BURAYA_RASTGELE_64_KARAKTER_HEX_GIRIN"

# İlk admin kullanıcı (sadece ilk başlatmada oluşturulur)
ADMIN_EMAIL="admin@sizin-firma.com"
ADMIN_PASSWORD="GUCLU_SIFRE_GIRIN_12345"
